#include <windows.h>

IDI_APP_ICON ICON "../../resources/app_icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Open Film Lab"
            VALUE "FileDescription",  "Open Film Lab - RAW & Film Negative Processing Tool"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "open-film-lab"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Open Film Lab Contributors"
            VALUE "OriginalFilename", "open-film-lab.exe"
            VALUE "ProductName",      "Open Film Lab"
            VALUE "ProductVersion",   "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
